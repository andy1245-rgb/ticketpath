# Leave API_BASE_URL unset to run entirely on the bundled mock fixtures.
# Point it at the backend (see API_CONTRACT.md) to switch to live data —
# no component changes required, lib/api.ts is the only seam.
NEXT_PUBLIC_API_BASE_URL=

# Solana cluster the wallet adapter and explorer links target.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional: override the default public RPC endpoint for the cluster above.
NEXT_PUBLIC_SOLANA_RPC_URL=

# The SeatPass program address. Deliberately empty: until it is set, the on-chain
# strip reads "Program not deployed yet" and the copy and explorer controls stay
# disabled, rather than render an address this build invented.
NEXT_PUBLIC_PROGRAM_ID=
