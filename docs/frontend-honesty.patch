diff -ruN a/components/SyntheticNotice.tsx b/components/SyntheticNotice.tsx
--- a/components/SyntheticNotice.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/components/SyntheticNotice.tsx	2026-11-07 11:17:26.117758186 +0000
@@ -0,0 +1,17 @@
+import type { DataSource } from "@/lib/types";
+
+/**
+ * The backend's own account of the payload, printed next to the numbers rather
+ * than in the header, because it is about them. Rendered only when the payload
+ * says it is synthetic, so a live ledger removes it without a code change.
+ */
+export function SyntheticNotice({ dataSource }: { dataSource?: DataSource | null }) {
+  if (!dataSource?.synthetic) return null;
+
+  return (
+    <p className="rounded-lg border border-hairline bg-plane px-4 py-2 text-xs text-ink-2">
+      {dataSource.label} No ticket program is deployed for this build, so every price and custody
+      row here is simulated.
+    </p>
+  );
+}
